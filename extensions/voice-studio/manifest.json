{
  "name": "voice-studio",
  "version": "0.2.0",
  "displayName": "Voice Studio (VieNeu-TTS)",
  "description": "Tạo bản nghe thử text-to-speech tiếng Việt/Anh hoàn toàn cục bộ bằng VieNeu-TTS. Không tải nội dung lên dịch vụ hosted và không hỗ trợ clone giọng.",
  "main": "dist/index.js",
  "engine": ">=0.1.0",
  "author": {
    "name": "Izzi AI Team",
    "url": "https://izziapi.com"
  },
  "permissions": [
    "storage.local",
    "ui.notification",
    "ui.panel",
    "net.http"
  ],
  "activationEvents": [
    "onCommand:voice-studio.status",
    "onCommand:voice-studio.listVoices",
    "onCommand:voice-studio.tts"
  ],
  "contributes": {
    "commands": [
      { "id": "voice-studio.status", "title": "Kiểm tra kết nối", "category": "Voice", "icon": "🔌" },
      { "id": "voice-studio.listVoices", "title": "Danh sách giọng", "category": "Voice", "icon": "🗣️" },
      { "id": "voice-studio.tts", "title": "Đọc văn bản (TTS)", "category": "Voice", "icon": "🔊" }
    ],
    "panels": [
      { "id": "voice-studio.dashboard", "title": "Voice Studio", "entry": "panel" }
    ],
    "settings": []
  },
  "categories": ["Voice", "Content"],
  "tags": ["tts", "vietnamese", "on-device", "voice", "offline"],
  "homepage": "https://izziapi.com",
  "pricing": { "model": "free" },
  "service": {
    "type": "docker-compose",
    "projectName": "izzi-svc-voice-studio",
    "compose": "service/docker-compose.izzi.yml",
    "ports": [
      { "name": "api", "container": 5111, "healthPath": "/health/ready", "bind": "127.0.0.1" }
    ],
    "readyTimeoutMs": 600000,
    "readyContract": {
      "status": "ready",
      "sdk": "vieneu",
      "sdk_version": "3.2.3",
      "model_repo": "pnnbao-ump/VieNeu-TTS-v3-Turbo",
      "model_revision": "75ff82a72f54d55ed389e1eeb12041d3c4bac7d4",
      "codec_repo": "OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano-ONNX",
      "codec_revision": "ceff0d0749bfb3fa2d61149794ec6feef0d1e1ae",
      "preset_catalog_sha256": "13f17165586ec132efd35076f46ec8de7f7e474a344e262c6360d89726eeb8d9"
    },
    "inject": { "backendUrl": "http://127.0.0.1:${port.api}" },
    "requires": { "docker": true }
  },
  "license": "SEE LICENSE"
}
