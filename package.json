{
  "name": "izzi-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Izzi AI Multi-Agent Gateway — Desktop AI Agent Hub (OpenClaw, Hermes, AutoGPT…) connected to IzziAPI",
  "homepage": "https://github.com/kentzu213/izzi-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentzu213/izzi-ai.git"
  },
  "bugs": {
    "url": "https://github.com/kentzu213/izzi-ai/issues"
  },
  "author": "kentzu213",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --filter @openclaw/desktop dev",
    "dev:marketplace": "pnpm --parallel --filter @openclaw/marketplace-api --filter @openclaw/desktop dev",
    "build": "pnpm --filter @openclaw/desktop build",
    "build:all": "pnpm -r build",
    "test:actions": "node --test tools/github-actions-runtime-contract.test.mjs",
    "test:lint-config": "node --test tools/eslint-config-contract.test.mjs",
    "test:socrates": "node --test tools/socrates-tier1.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@xmldom/xmldom": "0.8.13",
      "@hono/node-server": "2.0.10",
      "builder-util-runtime": "9.7.0",
      "fast-uri": "3.1.5",
      "form-data": "4.0.6",
      "hono": "4.12.34",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "nanoid": "3.3.17",
      "shell-quote": "1.10.0",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "tsx>esbuild": "0.28.2",
      "ws": "8.21.0",
      "postcss": "^8.5.18",
      "sharp": "0.35.3",
      "adm-zip": "0.6.0",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
