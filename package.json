{
  "name": "izzi-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Izzi AI Multi-Agent Gateway — Desktop AI Agent Hub (OpenClaw, Hermes, AutoGPT…) connected to IzziAPI",
  "homepage": "https://github.com/kentzu213/izzi-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentzu213/izzi-ai.git"
  },
  "bugs": {
    "url": "https://github.com/kentzu213/izzi-ai/issues"
  },
  "author": "kentzu213",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --filter @openclaw/desktop dev",
    "dev:marketplace": "pnpm --parallel --filter @openclaw/marketplace-api --filter @openclaw/desktop dev",
    "build": "pnpm --filter @openclaw/desktop build",
    "build:all": "pnpm -r build",
    "lint": "eslint apps packages extensions --no-error-on-unmatched-pattern",
    "lint:ci": "eslint apps packages extensions --no-error-on-unmatched-pattern --max-warnings 358",
    "lint:fix": "eslint apps packages extensions --no-error-on-unmatched-pattern --fix",
    "lint:strict": "eslint apps packages extensions --no-error-on-unmatched-pattern --max-warnings 0",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "9.7.0",
      "fast-uri": "3.1.4",
      "form-data": "4.0.6",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "shell-quote": "1.8.4",
      "ws": "8.21.0",
      "postcss": "^8.5.18",
      "sharp": "0.35.3",
      "adm-zip": "0.6.0"
    }
  }
}
