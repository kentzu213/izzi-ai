{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.izziapi.openclaw",
  "productName": "Izzi AI",
  "copyright": "Copyright © 2024-2026 Izzi AI",
  "artifactName": "Izzi-AI-${version}-${os}-${arch}.${ext}",
  "detectUpdateChannel": true,

  "directories": {
    "output": "release",
    "buildResources": "build"
  },

  "files": [
    "dist/**/*",
    "!dist/renderer/**/*.map",
    "package.json"
  ],

  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "build/icon.ico"
    },
    {
      "from": "build/icon.png",
      "to": "build/icon.png"
    },
    {
      "from": "build/icon.icns",
      "to": "build/icon.icns"
    },
    {
      "from": "resources/bundled-extensions",
      "to": "bundled-extensions"
    },
    {
      "from": "resources/customer-marketing-skills",
      "to": "customer-marketing-skills"
    }
  ],

  "beforePack": "scripts/before-pack.cjs",
  "afterPack": "scripts/after-pack.cjs",

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": true
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Izzi AI",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["en_US", "vi_VN"],
    "language": 1066
  },

  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "darkModeSupport": true
  },

  "dmg": {
    "contents": [
      { "x": 130, "y": 180 },
      { "x": 410, "y": 180, "type": "link", "path": "/Applications" }
    ],
    "background": "build/dmg-background.png",
    "window": {
      "width": 540,
      "height": 380
    }
  },

  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "rpm", "arch": ["x64"] }
    ],
    "icon": "build/icons",
    "category": "Development",
    "desktop": {
      "entry": {
        "Name": "Izzi AI",
        "Comment": "Smart AI assistant for every platform",
        "Terminal": "false"
      }
    },
    "synopsis": "AI-powered assistant desktop app"
  },

  "publish": {
    "provider": "github",
    "owner": "kentzu213",
    "repo": "izzi-ai",
    "releaseType": "release",
    "vPrefixedTagName": true
  },


  "extraMetadata": {
    "main": "dist/main/index.js"
  },

  "asar": true,
  "asarUnpack": [
    "node_modules/@esbuild/win32-x64/**/*",
    "node_modules/@hono/node-server/**/*",
    "node_modules/@img/colour/**/*",
    "node_modules/@img/sharp-darwin-arm64/**/*",
    "node_modules/@img/sharp-darwin-x64/**/*",
    "node_modules/@img/sharp-libvips-darwin-arm64/**/*",
    "node_modules/@img/sharp-libvips-darwin-x64/**/*",
    "node_modules/@img/sharp-win32-x64/**/*",
    "node_modules/@puppeteer/browsers/**/*",
    "node_modules/@swc/helpers/**/*",
    "node_modules/adm-zip/**/*",
    "node_modules/ansi-regex/**/*",
    "node_modules/ansi-styles/**/*",
    "node_modules/base64-js/**/*",
    "node_modules/brotli/**/*",
    "node_modules/bundle-name/**/*",
    "node_modules/chromium-bidi/**/*",
    "node_modules/cliui/**/*",
    "node_modules/clone/**/*",
    "node_modules/compare-versions/**/*",
    "node_modules/default-browser/**/*",
    "node_modules/default-browser-id/**/*",
    "node_modules/define-lazy-prop/**/*",
    "node_modules/detect-libc/**/*",
    "node_modules/devtools-protocol/**/*",
    "node_modules/dfa/**/*",
    "node_modules/emoji-regex/**/*",
    "node_modules/esbuild/**/*",
    "node_modules/escalade/**/*",
    "node_modules/fast-deep-equal/**/*",
    "node_modules/fontkit/**/*",
    "node_modules/get-caller-file/**/*",
    "node_modules/get-east-asian-width/**/*",
    "node_modules/hono/**/*",
    "node_modules/hyperframes/**/*",
    "node_modules/is-docker/**/*",
    "node_modules/is-inside-container/**/*",
    "node_modules/is-wsl/**/*",
    "node_modules/mitt/**/*",
    "node_modules/modern-tar/**/*",
    "node_modules/nanoid/**/*",
    "node_modules/open/**/*",
    "node_modules/pako/**/*",
    "node_modules/picocolors/**/*",
    "node_modules/postcss/**/*",
    "node_modules/puppeteer-core/**/*",
    "node_modules/restructure/**/*",
    "node_modules/run-applescript/**/*",
    "node_modules/semver/**/*",
    "node_modules/sharp/**/*",
    "node_modules/source-map-js/**/*",
    "node_modules/string-width/**/*",
    "node_modules/strip-ansi/**/*",
    "node_modules/tiny-inflate/**/*",
    "node_modules/tslib/**/*",
    "node_modules/typed-query-selector/**/*",
    "node_modules/unicode-properties/**/*",
    "node_modules/unicode-trie/**/*",
    "node_modules/webdriver-bidi-protocol/**/*",
    "node_modules/wrap-ansi/**/*",
    "node_modules/ws/**/*",
    "node_modules/wsl-utils/**/*",
    "node_modules/y18n/**/*",
    "node_modules/yargs/**/*",
    "node_modules/yargs-parser/**/*",
    "node_modules/zod/**/*",
    "dist/main/extensions/extension-runner.js"
  ],
  "afterSign": null
}
